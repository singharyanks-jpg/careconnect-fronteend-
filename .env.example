# CareConnect Frontend Environment Configuration

# Data layer mode: 'mock' (default, standalone with realistic simulated calls) or 'supabase'
VITE_DATA_ADAPTER=mock

# Supabase Configuration (Only client-safe URL and Public Anon Key)
# NEVER put service_role, LLM API keys, Twilio, or telephony credentials in the frontend!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
